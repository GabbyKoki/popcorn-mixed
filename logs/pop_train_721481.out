[rank: 0] Seed set to 42
paths:
  processed_data_dir: /gpfs/radev/home/jc4439/martinez_project/pop/data/schmidt/processed
  matching_index_path: ${paths.processed_data_dir}/matching_index.pkl
  log_dir: logs
data:
  fold_idx: 0
  h5ad_filename: schmidt_emb_pca_scvi_scgpt_${data.fold_idx}_fix.h5ad
  condition_col: gene
  cluster_col: cluster_name
  control_condition: NO-TARGET
  split_col: split_${data.fold_idx}
  cell_embed_key: X_scgpt_CP_512
  pert_embedding_key: esm2_gene_embedding_2560
  compute_matching: false
model:
  hidden_dim: 64
  n_heads: 4
  dim_feedforward: 128
  num_layers: 1
  dropout: 0.1
  lr: 0.001
  cell_loss_weight: 0.5
training:
  batch_size: 32
  epochs: 100
  seed: 42
  ood_mode: true
  n_bags: 50
  sample_ratio: 0.3
  sampler_type: bootstrap
  accelerator: gpu
  deterministic: true
  enable_checkpointing: false
  log_every_n_steps: 20
  patience: 10
logger:
  project: popcorn_mixed_mini_bags_ood
  name: experiment
  group: ${data.cell_embed_key}|${data.pert_embedding_key}|fold${data.fold_idx}
  tags:
  - run
  - ${data.cell_embed_key}
  - ${data.pert_embedding_key}
  - fold${data.fold_idx}
  log_model: true
  save_dir: ${paths.log_dir}

